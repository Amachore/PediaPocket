{
  "expo": {
    "name": "PediaPocket",
    "slug": "pediapocket",
    "version": "1.0.0",
    "description": "Offline-first baby activity tracker bridging parents and caregivers. Phase 1 MVP developed with AI assistance (Claude/Kiro). Concept, design, and architecture by human developer.",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/PediaPocketLogo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pediapocket.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/PediaPocketLogo.png",
        "backgroundColor": "#E8F2FF"
      },
      "package": "com.pediapocket.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/PediaPocketLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E8F2FF"
        }
      ]
    ]
  }
}
